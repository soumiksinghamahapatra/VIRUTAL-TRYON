# ==========================================
# MAISON — Virtual Try-On & E-Commerce Store
# Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Client URL (for CORS in development)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key
# (Required for Nano Banana gemini-3.1-flash-image Virtual Try-On)
# Note: Google requires a Pay-As-You-Go billing account linked in Google AI Studio
# for the image generation model (limit is 0 on free tier).
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (Cloud Atlas or Local)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/maison_db?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Environment Mode (development or production)
NODE_ENV=production
